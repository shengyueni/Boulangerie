.boundary-page {
  padding-bottom: 56rpx;
}

.boundary-note {
  margin-top: 22rpx;
  color: var(--ink);
  font-size: 25rpx;
  line-height: 1.6;
}

.boundary-note__title,
.boundary-label,
.responsibility-title,
.response-level {
  display: block;
  color: var(--page-theme);
  font-weight: 900;
}

.boundary-note__title {
  margin-bottom: 8rpx;
  font-size: 28rpx;
}

.boundary-card {
  margin-top: 18rpx;
  padding: 28rpx 24rpx;
}

.boundary-card__head {
  align-items: flex-start;
  gap: 18rpx;
}

.boundary-card__heading {
  min-width: 0;
  flex: 1;
}

.boundary-card .card-title {
  display: block;
  margin-top: 10rpx;
  font-size: 29rpx;
  line-height: 1.35;
}

.boundary-card .toggle-text {
  flex: 0 0 auto;
  padding-top: 4rpx;
  color: var(--page-theme);
  font-size: 22rpx;
  font-weight: 900;
}

.boundary-prompt {
  display: block;
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.boundary-body {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--page-theme-soft);
}

.boundary-label {
  margin: 22rpx 0 9rpx;
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.boundary-body > .boundary-label:first-child {
  margin-top: 0;
}

.boundary-signals {
  margin-top: 0;
}

.responsibility-grid,
.response-list {
  display: grid;
  gap: 12rpx;
}

.responsibility-card,
.response-card,
.evidence-note,
.malo-reminder {
  box-sizing: border-box;
  padding: 18rpx;
  border: 2rpx solid var(--page-theme-soft);
  border-radius: 18rpx;
  background: rgba(255, 254, 251, .82);
  color: var(--ink);
  font-size: 24rpx;
  line-height: 1.55;
}

.responsibility-title,
.response-level {
  margin-bottom: 6rpx;
  font-size: 22rpx;
}

.evidence-note {
  display: block;
  border-style: dashed;
}

.malo-reminder {
  margin-top: 22rpx;
  background: var(--page-tint);
}

.malo-reminder .boundary-label {
  margin-top: 0;
}
