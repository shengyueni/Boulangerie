.today-page {
  background: linear-gradient(180deg, #fffefb 0%, #fff9ef 100%);
}

.home-brand-head {
  margin-bottom: 10rpx;
  padding: 0 0 2rpx;
  text-align: center;
}

.home-brand-head .hero-title {
  margin-bottom: 4rpx;
  font-size: 44rpx;
}

.home-brand-head .subtext {
  font-size: 25rpx;
  line-height: 1.45;
}

.first-use-card {
  position: relative;
  overflow: hidden;
  margin: 18rpx 0 24rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(47, 123, 103, .28);
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(244, 250, 246, .98), rgba(255, 250, 242, .96));
  box-shadow: 0 12rpx 28rpx rgba(75, 91, 72, .08);
}

.first-use-card__head {
  min-width: 0;
  padding-right: 78rpx;
}

.first-use-card__eyebrow,
.first-use-card__title {
  display: block;
}

.first-use-card__eyebrow {
  color: var(--green);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.first-use-card__title {
  margin-top: 5rpx;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 900;
}

.first-use-card__close {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
}

.first-use-card__close-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  box-sizing: border-box;
  padding-bottom: 3rpx;
  border: 2rpx solid rgba(47, 123, 103, .16);
  border-radius: 50%;
  color: rgba(111, 91, 77, .56);
  background: rgba(255, 254, 251, .82);
  box-shadow: 0 4rpx 12rpx rgba(75, 91, 72, .05);
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1;
}

.first-use-card__skip::after,
.first-use-card__start::after {
  border: 0;
}

.first-use-steps {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
}

.first-use-step {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #6f5b4d;
  font-size: 25rpx;
  line-height: 1.4;
}

.first-use-step__number {
  display: flex;
  flex: 0 0 40rpx;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #fffefb;
  background: #6f9c82;
  font-size: 21rpx;
  font-weight: 900;
}

.first-use-card__actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.first-use-card__skip,
.first-use-card__start {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  margin: 0;
  padding: 8rpx 14rpx;
  border: 2rpx solid rgba(47, 123, 103, .3);
  border-radius: 22rpx;
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 900;
}

.first-use-card__skip {
  color: #6f5b4d;
  background: rgba(255, 254, 251, .8);
}

.first-use-card__start {
  color: var(--green);
  background: rgba(232, 245, 237, .92);
}

.oracle-card {
  margin-top: 2rpx;
  padding: 34rpx 24rpx 24rpx;
  overflow: hidden;
  text-align: center;
}

.oracle-bg,
.oracle-bg-image,
.oracle-sky,
.oracle-card .corner-ornament {
  position: absolute;
  pointer-events: none;
}

.oracle-card .title-pattern-image,
.oracle-bg-image {
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.14;
}

.oracle-bg {
  inset: 0;
  z-index: 1;
  background: rgba(255, 250, 242, 0.66);
}

.oracle-main,
.oracle-title-block,
.oracle-content {
  position: relative;
  z-index: 2;
}

.oracle-title-block {
  display: block;
  margin: 0 auto;
}

.oracle-header {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.oracle-date,
.oracle-card .paper-title__stamp {
  margin: 0 0 6rpx;
  padding: 6rpx 18rpx;
  line-height: 1.25;
}

.oracle-card .paper-title__rail {
  width: 100%;
  margin-top: 8rpx;
}

.oracle-title {
  display: block;
  margin: 0;
  color: var(--page-theme);
  font-size: 44rpx;
  line-height: 1.12;
  font-weight: 900;
  letter-spacing: 0;
}

.oracle-sky {
  z-index: 1;
  top: 8rpx;
  right: 18rpx;
  width: 112rpx;
  height: 112rpx;
  opacity: .16;
}

.oracle-ring {
  position: absolute;
  left: 18rpx;
  top: 20rpx;
  width: 98rpx;
  height: 98rpx;
  border: 3rpx solid rgba(27, 58, 92, .48);
  border-radius: 50%;
  box-shadow: inset 0 0 0 16rpx rgba(184, 138, 74, .08);
}

.oracle-star {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid rgba(184, 138, 74, .9);
  border-radius: 50% 50% 50% 0;
  transform: rotate(45deg);
  background: #fffefb;
}

.star-a { left: 10rpx; top: 18rpx; }
.star-b { right: 20rpx; top: 42rpx; border-color: rgba(184, 74, 58, .75); }
.star-c { left: 56rpx; bottom: 8rpx; border-color: rgba(47, 107, 79, .75); }

.oracle-content {
  margin-top: 18rpx;
}

.oracle-metrics {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10rpx;
  text-align: left;
}

.oracle-metric {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 16rpx 12rpx 20rpx;
  border: 2rpx solid rgba(184, 138, 74, .38);
  border-left-width: 8rpx;
  border-radius: 18rpx;
  background: rgba(255, 254, 251, .78);
  box-shadow: 0 8rpx 20rpx rgba(74, 52, 40, .05);
}

.metric-visual {
  display: flex;
  flex: 0 0 76rpx;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  min-height: 64rpx;
}

.metric-copy {
  min-width: 0;
  flex: 1;
}

.weather-symbol {
  color: #b86f3e;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 900;
}

.fur-state {
  width: 76rpx;
  height: 70rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #fff8ed;
}

.fur-state__image {
  width: 100%;
  height: 100%;
}

.visual-meter {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 5rpx;
  width: 72rpx;
  height: 48rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border: 3rpx solid rgba(111, 91, 77, .34);
  border-radius: 14rpx;
}

.visual-meter__bar {
  width: 10rpx;
  height: 100%;
  border-radius: 8rpx;
  background: rgba(111, 91, 77, .1);
}

.visual-meter__bar.is-on {
  background: #d88b56;
}

.visual-meter--cloud {
  height: 42rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
}

.visual-meter--cloud .visual-meter__bar {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(97, 120, 139, .12);
  box-shadow: 8rpx 8rpx 0 rgba(97, 120, 139, .08);
}

.visual-meter--cloud .visual-meter__bar.is-on {
  background: #8ca4b6;
  box-shadow: 8rpx 8rpx 0 rgba(140, 164, 182, .58);
}

.visual-meter--safety {
  position: relative;
  border-color: rgba(47, 123, 103, .42);
}

.visual-meter--safety::after {
  position: absolute;
  right: -8rpx;
  top: 14rpx;
  width: 6rpx;
  height: 16rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: rgba(47, 123, 103, .42);
  content: "";
}

.visual-meter--safety .visual-meter__bar.is-on {
  background: #4f987f;
}

.metric-name {
  display: block;
  color: var(--ink);
  font-size: 27rpx;
  line-height: 1.36;
  font-weight: 900;
}

.metric-desc {
  display: block;
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.oracle-slip-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 16rpx;
  text-align: left;
}

.oracle-slip {
  min-height: 104rpx;
}

.slip-label {
  display: block;
  margin-bottom: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.slip-text {
  display: block;
  color: var(--ink);
  font-size: 27rpx;
  line-height: 1.56;
  font-weight: 900;
}

.oracle-action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.oracle-save-button,
.oracle-insights-button {
  width: 100%;
  min-width: 0;
  min-height: 72rpx;
  margin: 0;
  padding: 8rpx 24rpx;
  border: 2rpx solid rgba(184, 74, 58, .34);
  border-radius: 999rpx;
  color: #9d4235;
  background: rgba(255, 254, 251, .88);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
}

.oracle-save-button::after {
  border: 0;
}

.oracle-insights-button {
  border: 2rpx solid rgba(39, 91, 74, .3);
  color: var(--green);
  background: rgba(235, 245, 238, .72);
}

.oracle-insights-button::after {
  border: 0;
}

.oracle-save-button.is-saved {
  border-color: rgba(39, 91, 74, .22);
  color: var(--green);
  background: rgba(235, 245, 238, .78);
}
