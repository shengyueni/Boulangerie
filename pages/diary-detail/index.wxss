.detail-card {
  padding: 46rpx 28rpx 30rpx;
  line-height: 1.65;
}

.detail-top {
  align-items: flex-start;
}

.date {
  padding-top: 8rpx;
  color: var(--muted);
  font-size: 25rpx;
  font-weight: 900;
}

.detail-type {
  min-height: 42rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
}


.detail-text,
.fact-memo {
  display: block;
  font-size: 29rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.info-card {
  margin-top: 0;
  padding: 42rpx 28rpx 28rpx;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.info-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-height: 112rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 2rpx solid rgba(184, 138, 74, 0.34);
  border-radius: 16rpx;
  background: rgba(255, 254, 251, 0.82);
  font-size: 27rpx;
  line-height: 1.55;
}

.info-row text:first-child {
  color: var(--muted);
  font-size: 23rpx;
  font-weight: 900;
}

.info-row text:last-child {
  color: var(--ink);
  font-weight: 900;
}

.info-row.vertical,
.info-row.full {
  grid-column: span 2;
}

.quick-info-grid {
  grid-template-columns: minmax(0, 1fr);
}

.quick-info-grid .info-row {
  width: 100%;
  min-height: 0;
  grid-column: auto;
}

.evidence-card {
  margin-top: 0;
  padding: 46rpx 28rpx 30rpx;
  background:
    linear-gradient(180deg, rgba(255, 254, 251, 0.98), rgba(255, 248, 237, 0.98)),
    repeating-linear-gradient(180deg, transparent 0 44rpx, rgba(184, 138, 74, 0.12) 44rpx 46rpx);
}

.memo-seal {
  margin-bottom: 12rpx;
}

.fact-memo {
  margin-top: 12rpx;
  padding: 22rpx;
  border: 2rpx dashed rgba(90, 70, 56, 0.34);
  border-radius: 16rpx;
  background: rgba(255, 254, 251, 0.72);
  color: #5d4b40;
  font-size: 27rpx;
}

.detail-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.detail-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 76rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 10rpx 12rpx;
  border: 2rpx solid var(--page-theme-soft);
  border-radius: 18rpx;
  color: var(--page-theme);
  background: rgba(255, 254, 251, .9);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.3;
  white-space: normal;
  box-shadow: 0 6rpx 14rpx rgba(39, 91, 74, .06);
}

.detail-action::after {
  border: 0;
}

.detail-action--primary {
  border-style: double;
  border-width: 4rpx;
  background: var(--page-tint);
}

.detail-action--danger {
  border-style: dashed;
  border-color: rgba(161, 61, 54, .34);
  color: rgba(161, 61, 54, .78);
  background: transparent;
  box-shadow: none;
  font-weight: 800;
}
/* MVP 1.0A diary detail green theme accents */
.theme-diary .info-row,
.theme-diary .fact-memo {
  border-color: var(--page-theme-soft);
}

@media (max-width: 360px) {
  .detail-action {
    min-height: 72rpx;
    padding: 8rpx 10rpx;
    font-size: 22rpx;
  }
}
